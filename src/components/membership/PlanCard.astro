---
import type { MembershipPlan } from "@data/memberships";
import { SITE } from "@data/site";
import type { Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";

interface Props {
  plan: MembershipPlan;
  lang: Lang;
}

const { plan, lang } = Astro.props;
const price = new Intl.NumberFormat(lang === "es" ? "es-US" : "en-US", {
  style: "currency",
  currency: plan.currency,
  maximumFractionDigits: 0,
}).format(plan.price);

const billing =
  lang === "es" ? "por año" : "per year";

const ctaHref =
  plan.cta.key === "contact"
    ? SITE.contact.emailHref
    : localizedHref("apply", lang);
---

<article
  class:list={["plan-card", { "plan-card--featured": plan.featured }]}
  data-reveal="up"
>
  {plan.featured && (
    <p class="plan-card__badge">
      {lang === "es" ? "Cobertura más completa" : "Most comprehensive"}
    </p>
  )}
  <header class="plan-card__header">
    <h3>{plan.name}</h3>
    <p class="plan-card__price">
      <span class="plan-card__amount">{price}</span>
      <span class="plan-card__billing">{billing}</span>
    </p>
    <p class="plan-card__audience">{plan.audience[lang]}</p>
  </header>

  <ul class="plan-card__highlights">
    {
      plan.highlights[lang].map((highlight) => (
        <li>
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span>{highlight}</span>
        </li>
      ))
    }
  </ul>

  <a
    class:list={["btn", plan.featured ? "btn--gold" : "btn--primary"]}
    href={ctaHref}
  >
    {plan.cta.labels[lang]}
  </a>
</article>

<style>
  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .plan-card--featured {
    border-color: var(--color-gold-500);
    box-shadow: var(--shadow-lg);
  }

  .plan-card__badge {
    position: absolute;
    top: -0.85rem;
    left: 1.5rem;
    margin: 0;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--color-gold-500);
    color: var(--color-navy-900);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .plan-card__header h3 {
    margin-bottom: 0.35rem;
    font-size: var(--text-2xl);
  }

  .plan-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
  }

  .plan-card__amount {
    color: var(--color-navy-800);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
  }

  .plan-card__billing {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .plan-card__audience {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .plan-card__highlights {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-card__highlights li {
    display: flex;
    gap: 0.55rem;
    margin: 0;
    color: var(--color-body);
    font-size: var(--text-sm);
  }

  .plan-card__highlights svg {
    flex: 0 0 auto;
    margin-top: 0.2rem;
    color: var(--color-navy-600);
  }

  .plan-card .btn {
    margin-top: auto;
  }
</style>
