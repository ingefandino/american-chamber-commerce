---
import { ACCESS_LABELS, type Service } from "@data/services";
import type { Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";

interface Props {
  service: Service;
  lang: Lang;
}

const { service, lang } = Astro.props;
---

<article class="service-card" data-reveal="up">
  <p class="service-card__access">{ACCESS_LABELS[service.access][lang]}</p>
  <h3>
    <a href={`${localizedHref("services", lang)}${service.slug}/`}>
      {service.name[lang]}
    </a>
  </h3>
  <p class="service-card__summary">{service.summary[lang]}</p>
  <a
    class="service-card__link"
    href={`${localizedHref("services", lang)}${service.slug}/`}
  >
    {lang === "es" ? "Ver servicio" : "View service"}
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-gold-300);
    box-shadow: var(--shadow-md);
  }

  .service-card__access {
    margin: 0 0 0.75rem;
    color: var(--color-gold-600);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card h3 {
    margin-bottom: 0.5rem;
    font-size: var(--text-xl);
  }

  .service-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .service-card h3 a:hover,
  .service-card h3 a:focus-visible {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-500);
    text-decoration-thickness: 2px;
  }

  .service-card__summary {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: var(--color-navy-700);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .service-card__link:hover,
  .service-card__link:focus-visible {
    color: var(--color-gold-600);
  }
</style>
