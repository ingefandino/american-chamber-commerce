---
import {
  formatEventDate,
  MODALITY_LABELS,
  STATUS_LABELS,
  type ChamberEvent,
} from "@data/events";
import type { Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";

interface Props {
  event: ChamberEvent;
  lang: Lang;
}

const { event, lang } = Astro.props;
const locale = lang === "es" ? "es-US" : "en-US";
const start = new Date(`${event.date}T${event.startTime}:00`);
const month = new Intl.DateTimeFormat(locale, {
  month: "short",
  timeZone: event.timezone,
}).format(start);
const day = new Intl.DateTimeFormat(locale, {
  day: "2-digit",
  timeZone: event.timezone,
}).format(start);
const href = `${localizedHref("events", lang)}${event.slug}/`;
---

<article class="event-card" data-reveal="up">
  <div class="event-card__date" aria-hidden="true">
    <span class="event-card__month">{month}</span>
    <span class="event-card__day">{day}</span>
  </div>

  <div class="event-card__body">
    <p class="event-card__status">{STATUS_LABELS[event.status][lang]}</p>
    <h3>
      <a href={href}>{event.title[lang]}</a>
    </h3>
    <p class="event-card__summary">{event.summary[lang]}</p>

    <dl class="event-card__meta">
      <div>
        <dt class="sr-only">{lang === "es" ? "Fecha y hora" : "Date and time"}</dt>
        <dd>{formatEventDate(event, lang)}</dd>
      </div>
      <div>
        <dt class="sr-only">{lang === "es" ? "Lugar" : "Location"}</dt>
        <dd>
          {event.location.name}
          {event.location.city ? ` — ${event.location.city}` : ""}
        </dd>
      </div>
      <div>
        <dt class="sr-only">{lang === "es" ? "Modalidad" : "Format"}</dt>
        <dd>{MODALITY_LABELS[event.modality][lang]}</dd>
      </div>
    </dl>

    <a class="event-card__link" href={href}>
      {lang === "es" ? "Ver evento" : "View event"}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .event-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .event-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-gold-300);
    box-shadow: var(--shadow-md);
  }

  .event-card__date {
    display: grid;
    place-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background: var(--color-navy-800);
    color: var(--color-white);
    text-align: center;
    line-height: 1.1;
  }

  .event-card__month {
    color: var(--color-gold-300);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-card__day {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .event-card__status {
    margin: 0 0 0.4rem;
    color: var(--color-gold-600);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-card h3 {
    margin-bottom: 0.4rem;
    font-size: var(--text-xl);
  }

  .event-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .event-card h3 a:hover,
  .event-card h3 a:focus-visible {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-500);
    text-decoration-thickness: 2px;
  }

  .event-card__summary {
    margin: 0 0 0.9rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .event-card__meta {
    display: grid;
    gap: 0.3rem;
    margin: 0 0 1rem;
    color: var(--color-body);
    font-size: var(--text-xs);
  }

  .event-card__meta div {
    margin: 0;
  }

  .event-card__meta dd {
    margin: 0;
  }

  .event-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-navy-700);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .event-card__link:hover,
  .event-card__link:focus-visible {
    color: var(--color-gold-600);
  }
</style>
