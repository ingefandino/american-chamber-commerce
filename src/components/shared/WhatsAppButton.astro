---
import { SITE } from "@data/site";
import type { Lang } from "@lib/lang";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const label =
  lang === "es"
    ? "Contactar a American Chamber of Commerce por WhatsApp"
    : "Contact the American Chamber of Commerce on WhatsApp";
const newTab = lang === "es" ? "(se abre en una pestaña nueva)" : "(opens in a new tab)";

const href = `${SITE.whatsapp.href}?text=${encodeURIComponent(
  SITE.whatsapp.message[lang],
)}`;
---

<a
  class="whatsapp-button"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label} ${newTab}`}
  data-whatsapp
>
  <span class="whatsapp-button__wave" aria-hidden="true"></span>
  <span class="whatsapp-button__wave whatsapp-button__wave--delay" aria-hidden="true"></span>
  <span class="whatsapp-button__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
      <path
        d="M20.52 3.48A11.78 11.78 0 0 0 12.05 0C5.5 0 .18 5.32.18 11.86c0 2.09.55 4.13 1.6 5.93L0 24l6.37-1.67a11.9 11.9 0 0 0 5.68 1.45h.01c6.54 0 11.86-5.32 11.86-11.86 0-3.17-1.23-6.15-3.4-8.44ZM12.06 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.78.99 1.01-3.69-.23-.38a9.86 9.86 0 0 1-1.51-5.27c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.43 9.88-9.86 9.88Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.09 3.2 5.07 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"
      ></path>
    </svg>
  </span>
</a>

<style>
  .whatsapp-button {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #0b6b4f;
    color: #ffffff;
    box-shadow: 0 10px 24px -10px rgb(7 26 48 / 0.65);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .whatsapp-button:hover,
  .whatsapp-button:focus-visible {
    background: #07523d;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .whatsapp-button:focus-visible {
    outline: 3px solid var(--color-gold-500);
    outline-offset: 3px;
  }

  .whatsapp-button__icon {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
  }

  .whatsapp-button__wave {
    position: absolute;
    inset: 0;
    border: 2px solid rgb(11 107 79 / 0.55);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    animation: whatsapp-wave 3s ease-out infinite;
  }

  .whatsapp-button__wave--delay {
    animation-delay: 1.5s;
  }

  @keyframes whatsapp-wave {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.25);
    }
  }

  @media (max-width: 480px) {
    .whatsapp-button {
      right: max(0.85rem, env(safe-area-inset-right));
      bottom: max(0.85rem, env(safe-area-inset-bottom));
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-button {
      transition: none;
    }

    .whatsapp-button__wave {
      animation: none;
      opacity: 0;
    }
  }
</style>
