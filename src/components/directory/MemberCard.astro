---
import type { PublicMember } from "@data/members";
import type { Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";

interface Props {
  member: PublicMember;
  lang: Lang;
}

const { member, lang } = Astro.props;
const href = `${localizedHref("members", lang)}${member.slug}/`;
---

<article class="member-card" data-reveal="up">
  <p class="member-card__sector">{member.sector[lang]}</p>
  <h3>
    <a href={href}>{member.name}</a>
  </h3>
  <p class="member-card__location">
    {member.location.city}
    {member.location.region ? `, ${member.location.region}` : ""}
    {member.location.country ? ` — ${member.location.country}` : ""}
  </p>
  <p class="member-card__description">{member.description[lang]}</p>
  <a class="member-card__link" href={href}>
    {lang === "es" ? "Ver perfil" : "View profile"}
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .member-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .member-card__sector {
    margin: 0 0 0.5rem;
    color: var(--color-gold-600);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .member-card h3 {
    margin-bottom: 0.35rem;
    font-size: var(--text-xl);
  }

  .member-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .member-card h3 a:hover,
  .member-card h3 a:focus-visible {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-500);
    text-decoration-thickness: 2px;
  }

  .member-card__location {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .member-card__description {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .member-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: var(--color-navy-700);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
</style>
