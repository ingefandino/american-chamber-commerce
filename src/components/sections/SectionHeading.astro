---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  light?: boolean;
  level?: "h2" | "h3";
}

const {
  eyebrow,
  title,
  lead,
  align = "left",
  light = false,
  level = "h2",
} = Astro.props;

const Heading = level;
---

<div
  class:list={[
    "section-heading",
    `section-heading--${align}`,
    { "section-heading--light": light },
  ]}
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading>{title}</Heading>
  {lead && <p class="section-heading__lead">{lead}</p>}
</div>

<style>
  .section-heading {
    max-width: 720px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading--center :global(.eyebrow) {
    justify-content: center;
  }

  .section-heading--light :global(h2),
  .section-heading--light :global(h3) {
    color: var(--color-white);
  }

  .section-heading--light :global(.eyebrow) {
    color: var(--color-gold-300);
  }

  .section-heading__lead {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .section-heading--light .section-heading__lead {
    color: rgb(255 255 255 / 0.78);
  }
</style>
