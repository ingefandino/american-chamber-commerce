---
interface LinkProps {
  label: string;
  href: string;
}

interface Props {
  title: string;
  text: string;
  primary: LinkProps;
  secondary?: LinkProps;
}

const { title, text, primary, secondary } = Astro.props;
---

<section class="cta-band section--navy" data-reveal="up">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--gold" href={primary.href}>{primary.label}</a>
      {
        secondary && (
          <a class="btn btn--outline" href={secondary.href}>
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    background:
      radial-gradient(circle at 15% 20%, rgb(200 162 74 / 0.16), transparent 42%),
      var(--color-navy-800);
  }

  .cta-band__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .cta-band__copy {
    max-width: 640px;
  }

  .cta-band h2 {
    margin-bottom: 0.5rem;
    color: var(--color-white);
    font-size: var(--text-3xl);
  }

  .cta-band p {
    margin: 0;
    color: rgb(255 255 255 / 0.8);
    font-size: var(--text-lg);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }

    .cta-band__actions {
      justify-content: flex-end;
    }
  }
</style>
