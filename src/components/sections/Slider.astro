---
import { Picture } from "astro:assets";
import type { Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";
import type { Slide } from "@data/slider";

interface Props {
  slides: Slide[];
  lang: Lang;
  interval?: number;
  label?: string;
  id?: string;
}

const {
  slides,
  lang,
  interval = 6500,
  label = lang === "es" ? "Contenido destacado" : "Featured content",
  id,
} = Astro.props;

const count = slides.length;
const ratio = `${slides[0].image.width} / ${slides[0].image.height}`;
const extended = [slides[count - 1], ...slides, slides[0]];
const lastPos = extended.length - 1;

const ui = {
  en: {
    previous: "Previous slide",
    next: "Next slide",
    dots: "Go to a slide",
    play: "Play slideshow",
    pause: "Pause slideshow",
  },
  es: {
    previous: "Diapositiva anterior",
    next: "Diapositiva siguiente",
    dots: "Ir a una diapositiva",
    play: "Reproducir presentación",
    pause: "Pausar presentación",
  },
} as const;

const text = ui[lang];
---

<section
  class="slider"
  id={id}
  data-slider
  data-interval={interval}
  data-label-pause={text.pause}
  data-label-play={text.play}
  style={`--slider-ratio:${ratio}`}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="slider__viewport" data-slider-viewport>
    <div
      class="slider__track"
      data-slider-track
      style="transform: translate3d(-100%, 0, 0)"
    >
      {
        extended.map((slide, index) => {
          const isClone = index === 0 || index === lastPos;
          const isFirstReal = index === 1;
          const Heading = isFirstReal ? "h1" : "h2";
          const position = index === 0 ? count : index === lastPos ? 1 : index;
          const ctaHref = slide.cta
            ? localizedHref(slide.cta.key, lang)
            : undefined;

          return (
            <div
              class="slider__slide"
              data-slide
              data-clone={isClone ? "true" : undefined}
              role="group"
              aria-roledescription="slide"
              aria-label={`${position} / ${count}`}
              aria-hidden={isFirstReal ? "false" : "true"}
            >
              <Picture
                src={slide.image}
                alt={slide.alt}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={72}
                widths={[640, 960, 1280, 1600]}
                sizes="100vw"
                loading={isFirstReal ? "eager" : "lazy"}
                fetchpriority={isFirstReal ? "high" : "auto"}
                decoding={isFirstReal ? "sync" : "async"}
              />
              <div class="slider__caption">
                <div class="slider__caption-inner">
                  <span class="slider__eyebrow">{slide.eyebrow}</span>
                  <Heading class="slider__title">{slide.title}</Heading>
                  <p class="slider__text">{slide.text}</p>
                  {ctaHref && (
                    <a
                      class="btn btn--gold slider__button"
                      href={ctaHref}
                      tabindex={isClone ? -1 : undefined}
                    >
                      {slide.cta?.label}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="slider__dots" role="tablist" aria-label={text.dots}>
      {
        slides.map((slide, index) => (
          <button
            class="slider__dot"
            type="button"
            role="tab"
            data-slider-dot
            aria-label={slide.title}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            <span class="slider__dot-bar" />
          </button>
        ))
      }
    </div>

    <button
      class="slider__arrow slider__arrow--prev"
      type="button"
      data-slider-prev
      aria-label={text.previous}
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      class="slider__arrow slider__arrow--next"
      type="button"
      data-slider-next
      aria-label={text.next}
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <button
      class="slider__toggle"
      type="button"
      data-slider-toggle
      aria-pressed="false"
      aria-label={text.pause}
    >
      <svg
        class="slider__icon slider__icon--pause"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect x="6" y="5" width="4" height="14" rx="1"></rect>
        <rect x="14" y="5" width="4" height="14" rx="1"></rect>
      </svg>
      <svg
        class="slider__icon slider__icon--play"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  function setupSlider(root: HTMLElement) {
    if (root.dataset.ready === "true") return;

    const track = root.querySelector<HTMLElement>("[data-slider-track]");
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>("[data-slide]"),
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-slider-dot]"),
    );
    const viewport = root.querySelector<HTMLElement>("[data-slider-viewport]");
    const toggle = root.querySelector<HTMLButtonElement>(
      "[data-slider-toggle]",
    );
    const count = dots.length;

    if (!track || count < 2 || slides.length < 3) return;

    root.dataset.ready = "true";

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const interval = Number(root.dataset.interval || 6500);
    root.style.setProperty("--slider-interval", `${interval}ms`);

    slides.forEach((slide) => {
      if (slide.dataset.clone !== "true") return;
      slide.querySelectorAll("a, button").forEach((element) => {
        (element as HTMLElement).tabIndex = -1;
        element.setAttribute("aria-hidden", "true");
      });
    });

    let pos = 1;
    const realIndex = () => (((pos - 1) % count) + count) % count;

    const restartBar = (dot: HTMLElement) => {
      const bar = dot.querySelector<HTMLElement>(".slider__dot-bar");
      if (!bar) return;
      bar.style.animation = "none";
      void bar.offsetWidth;
      bar.style.animation = "";
    };

    const applyTransform = (animate: boolean) => {
      if (!animate) track.classList.add("is-jumping");
      track.style.transform = `translate3d(-${pos * 100}%, 0, 0)`;
      if (!animate) {
        void track.offsetWidth;
        track.classList.remove("is-jumping");
      }
    };

    const setActive = (restart: boolean) => {
      const activeIndex = realIndex();
      slides.forEach((slide, index) => {
        const isClone = slide.dataset.clone === "true";
        const active = index === pos;
        slide.classList.toggle("is-active", active);
        slide.setAttribute(
          "aria-hidden",
          isClone ? "true" : active ? "false" : "true",
        );
      });
      dots.forEach((dot, index) => {
        const active = index === activeIndex;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-selected", active ? "true" : "false");
        dot.tabIndex = active ? 0 : -1;
        if (active && restart) restartBar(dot);
      });
    };

    const normalize = () => {
      if (pos === count + 1) {
        pos = 1;
        setActive(false);
        applyTransform(false);
      } else if (pos === 0) {
        pos = count;
        setActive(false);
        applyTransform(false);
      }
    };

    const step = (direction: number) => {
      pos += direction;
      setActive(true);
      applyTransform(!reduced);
      if (reduced) normalize();
    };

    const goToReal = (target: number) => {
      const current = realIndex();
      if (current === target) return;
      if (current === count - 1 && target === 0) pos = count + 1;
      else if (current === 0 && target === count - 1) pos = 0;
      else pos = target + 1;
      setActive(true);
      applyTransform(!reduced);
      if (reduced) normalize();
    };

    track.addEventListener("transitionend", (event) => {
      if (event.propertyName === "transform") normalize();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => goToReal(index));
      const bar = dot.querySelector<HTMLElement>(".slider__dot-bar");
      bar?.addEventListener("animationend", () => {
        if (
          index === realIndex() &&
          !reduced &&
          !root.classList.contains("is-paused")
        ) {
          step(1);
        }
      });
    });

    root
      .querySelector<HTMLElement>("[data-slider-prev]")
      ?.addEventListener("click", () => step(-1));
    root
      .querySelector<HTMLElement>("[data-slider-next]")
      ?.addEventListener("click", () => step(1));

    let userPaused = reduced;
    let hoverPaused = false;

    const syncPaused = () => {
      const paused = userPaused || hoverPaused || document.hidden;
      root.classList.toggle("is-paused", paused);
      if (!toggle) return;
      const isPaused = userPaused;
      toggle.setAttribute("aria-pressed", isPaused ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        isPaused
          ? (root.dataset.labelPlay ?? "Play slideshow")
          : (root.dataset.labelPause ?? "Pause slideshow"),
      );
      toggle.dataset.state = isPaused ? "paused" : "playing";
    };

    toggle?.addEventListener("click", () => {
      userPaused = !userPaused;
      syncPaused();
    });

    root.addEventListener("pointerenter", () => {
      hoverPaused = true;
      syncPaused();
    });
    root.addEventListener("pointerleave", () => {
      hoverPaused = false;
      syncPaused();
    });
    root.addEventListener("focusin", () => {
      hoverPaused = true;
      syncPaused();
    });
    root.addEventListener("focusout", () => {
      hoverPaused = false;
      syncPaused();
    });
    document.addEventListener("visibilitychange", syncPaused);

    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        step(1);
      }
    });

    let startX = 0;
    let dragging = false;
    viewport?.addEventListener("pointerdown", (event) => {
      dragging = true;
      startX = event.clientX;
    });
    viewport?.addEventListener("pointerup", (event) => {
      if (!dragging) return;
      dragging = false;
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 45) step(delta < 0 ? 1 : -1);
    });
    viewport?.addEventListener("pointercancel", () => {
      dragging = false;
    });

    applyTransform(false);
    setActive(true);
    syncPaused();
  }

  const initSliders = () => {
    document
      .querySelectorAll<HTMLElement>("[data-slider]")
      .forEach(setupSlider);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSliders);
  } else {
    initSliders();
  }
</script>

<style>
  .slider {
    --slider-interval: 6500ms;
    position: relative;
    width: 100%;
    overflow: hidden;
    color: var(--color-white);
    background: var(--color-navy-800);
    isolation: isolate;
  }

  .slider__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    touch-action: pan-y;
  }

  .slider__track {
    display: flex;
    width: 100%;
    transition: transform 0.85s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .slider__track.is-jumping {
    transition: none !important;
  }

  .slider__slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: var(--slider-ratio, 16 / 7);
    min-height: clamp(520px, 78dvh, 760px);
    overflow: hidden;
  }

  .slider__slide :global(picture),
  .slider__slide :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slider__slide :global(img) {
    transform: scale(1.02);
    transition: transform calc(var(--slider-interval) + 1000ms) ease-out;
  }

  .slider__slide.is-active :global(img) {
    transform: scale(1.08);
  }

  .slider__slide::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(7 26 48 / 0.55) 0%, rgb(7 26 48 / 0) 32%),
      linear-gradient(
        90deg,
        rgb(7 26 48 / 0.9) 0%,
        rgb(7 26 48 / 0.62) 44%,
        rgb(7 26 48 / 0.1) 78%
      );
  }

  .slider__caption {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    padding: 0 1.75rem 4.5rem;
    pointer-events: none;
  }

  .slider__caption-inner {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
  }

  .slider__eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: var(--radius-pill);
    background: rgb(200 162 74 / 0.26);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .slider__title {
    margin: 0;
    max-width: 16ch;
    color: var(--color-white);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 1.05;
  }

  .slider__text {
    margin: 1rem 0 0;
    max-width: 52ch;
    color: rgb(255 255 255 / 0.86);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .slider__button {
    margin-top: 1.7rem;
    pointer-events: auto;
  }

  .slider__dots {
    position: absolute;
    top: calc(var(--header-height) + 1.5rem);
    left: 50%;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-pill);
    background: rgb(7 26 48 / 0.32);
    transform: translateX(-50%);
    backdrop-filter: blur(8px) saturate(160%);
  }

  .slider__dot {
    position: relative;
    width: 11px;
    height: 11px;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.45);
    cursor: pointer;
    transition:
      width 0.5s cubic-bezier(0.65, 0, 0.35, 1),
      background-color 0.3s ease;
  }

  .slider__dot:hover {
    background: rgb(255 255 255 / 0.75);
  }

  .slider__dot.is-active {
    width: 54px;
    background: rgb(255 255 255 / 0.28);
  }

  .slider__dot-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--color-gold-500);
  }

  .slider__dot.is-active .slider__dot-bar {
    width: 100%;
    animation: slider-progress var(--slider-interval, 6500ms) linear forwards;
  }

  .slider.is-paused .slider__dot.is-active .slider__dot-bar {
    animation-play-state: paused;
  }

  @keyframes slider-progress {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .slider__arrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    background: rgb(7 26 48 / 0.28);
    color: var(--color-white);
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(8px);
    transition:
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .slider__arrow:hover {
    background: rgb(7 26 48 / 0.6);
    transform: translateY(-50%) scale(1.06);
  }

  .slider__arrow--prev {
    left: 1.25rem;
  }

  .slider__arrow--next {
    right: 1.25rem;
  }

  .slider__toggle {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    background: rgb(7 26 48 / 0.4);
    color: var(--color-white);
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .slider__icon--play {
    display: none;
  }

  .slider__toggle[data-state="paused"] .slider__icon--pause {
    display: none;
  }

  .slider__toggle[data-state="paused"] .slider__icon--play {
    display: block;
  }

  .slider__dot:focus-visible,
  .slider__arrow:focus-visible,
  .slider__toggle:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .slider__caption {
      padding: 0 1.25rem 4rem;
    }

    .slider__title {
      max-width: 14ch;
    }

    .slider__arrow {
      display: none;
    }

    .slider__dots {
      top: calc(var(--header-height) + 1rem);
    }
  }

  @media (max-width: 480px) {
    .slider__dot.is-active {
      width: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slider__track {
      transition: none;
    }

    .slider__slide :global(img),
    .slider__slide.is-active :global(img) {
      transform: none;
      transition: none;
    }

    .slider__dot {
      transition: none;
    }

    .slider__dot.is-active .slider__dot-bar {
      width: 100%;
      animation: none;
    }

    .slider__toggle {
      display: none;
    }
  }
</style>
