---
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<section class="trust-bar" aria-label={label} data-reveal="up">
  <div class="container">
    <p class="trust-bar__label">{label}</p>
    <ul class="trust-bar__list">
      {
        items.map((item) => (
          <li>{item}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust-bar {
    padding-block: 1.9rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .trust-bar__label {
    margin: 0 0 0.9rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-align: center;
    text-transform: uppercase;
  }

  .trust-bar__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-bar__list li {
    margin: 0;
    color: var(--color-navy-700);
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .trust-bar__list li + li {
    position: relative;
  }

  @media (min-width: 720px) {
    .trust-bar__list li + li::before {
      content: "";
      position: absolute;
      top: 50%;
      left: -0.95rem;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--color-gold-500);
      transform: translateY(-50%);
    }
  }
</style>
