---
import "@styles/global.css";
import Seo from "@components/shared/Seo.astro";
import Header from "@components/shared/Header.astro";
import Footer from "@components/shared/Footer.astro";
import WhatsAppButton from "@components/shared/WhatsAppButton.astro";
import BackToTop from "@components/shared/BackToTop.astro";
import Breadcrumbs from "@components/shared/Breadcrumbs.astro";
import { htmlLang, type Lang } from "@lib/lang";
import { buildBreadcrumbs } from "@lib/breadcrumbs";
import {
  LANGUAGE_SCROLL_KEY,
  LANGUAGE_SCROLL_MAX_AGE,
} from "@lib/scrollRestoration";
import type { JsonLd } from "@lib/structuredData";

interface Props {
  lang?: Lang;
  title: string;
  description?: string;
  pathname?: string;
  noIndex?: boolean;
  availableLangs?: Lang[];
  structuredData?: JsonLd | JsonLd[];
}

const {
  lang = "en",
  title,
  description = "American Chamber of Commerce connects businesses with the resources, relationships, and representation they need to compete and grow.",
  noIndex = false,
  availableLangs = ["en", "es"],
  structuredData = [],
} = Astro.props;

const pathname = Astro.props.pathname ?? Astro.url?.pathname ?? `/${lang}/`;
const breadcrumbs = buildBreadcrumbs(pathname, lang, title);
const skipLabel = lang === "es" ? "Saltar al contenido" : "Skip to content";
const themeColor = "#0b2545";
---

<!doctype html>
<html lang={htmlLang(lang)} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
    />
    <Seo
      lang={lang}
      pathname={pathname}
      title={title}
      description={description}
      noIndex={noIndex}
      availableLangs={availableLangs}
      structuredData={structuredData}
      breadcrumbs={breadcrumbs}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header lang={lang} pathname={pathname} availableLangs={availableLangs} />
    <main id="main" tabindex="-1">
      <Breadcrumbs items={breadcrumbs} lang={lang} />
      <slot />
    </main>
    <Footer lang={lang} pathname={pathname} availableLangs={availableLangs} />
    <WhatsAppButton lang={lang} />
    <BackToTop lang={lang} />
    <slot name="footer" />
    <script
      is:inline
      define:vars={{ LANGUAGE_SCROLL_KEY, LANGUAGE_SCROLL_MAX_AGE }}
    >
      (() => {
        const currentPath = () =>
          `${location.pathname}${location.search}${location.hash}`;
        let restored = false;

        const restore = () => {
          if (restored) return;

          let record = null;
          try {
            const raw = sessionStorage.getItem(LANGUAGE_SCROLL_KEY);
            if (!raw) return;
            record = JSON.parse(raw);
          } catch {
            try {
              sessionStorage.removeItem(LANGUAGE_SCROLL_KEY);
            } catch {}
            return;
          }

          const age = Date.now() - record?.createdAt;
          const valid =
            record &&
            record.target === currentPath() &&
            typeof record.ratio === "number" &&
            Number.isFinite(record.ratio) &&
            typeof record.placement === "string" &&
            record.placement.length > 0 &&
            Number.isFinite(age) &&
            age >= 0 &&
            age <= LANGUAGE_SCROLL_MAX_AGE;

          if (!valid) {
            try {
              sessionStorage.removeItem(LANGUAGE_SCROLL_KEY);
            } catch {}
            return;
          }

          restored = true;
          try {
            sessionStorage.removeItem(LANGUAGE_SCROLL_KEY);
          } catch {}

          const ratio = Math.min(1, Math.max(0, record.ratio));
          const max = Math.max(
            0,
            document.documentElement.scrollHeight - window.innerHeight,
          );
          const root = document.documentElement;
          const previous = root.style.scrollBehavior;
          root.style.scrollBehavior = "auto";
          window.scrollTo(0, Math.round(ratio * max));
          root.style.scrollBehavior = previous;

          const links = Array.from(
            document.querySelectorAll("[data-language-switch]"),
          ).filter((link) => link.dataset.placement === record.placement);
          const visible =
            links.find((link) => link.getClientRects().length > 0) ?? links[0];
          visible?.focus({ preventScroll: true });
        };

        restore();

        document.addEventListener("astro:page-load", () => {
          restored = false;
          requestAnimationFrame(restore);
        });
      })();
    </script>
    <script>
      import { initReveal } from "@scripts/reveal";

      initReveal();
    </script>
  </body>
</html>
