---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/forms/ContactForm.astro";
import { SITE } from "@data/site";
import { isLang, type Lang } from "@lib/lang";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const params = Astro.params;
const lang: Lang = isLang(params.lang) ? params.lang : "en";

const copy = {
  en: {
    title: "Contact",
    eyebrow: "Contact",
    heading: "Talk with the Chamber",
    lead: "Send a message about membership, events, sponsorship, media, or a general question. Our team will route it to the right person.",
    detailsTitle: "Contact details",
    email: "Email",
    phone: "Phone",
    address: "Address",
    social: "Social",
    privacy: "For privacy requests, email us with the subject “Privacy request”.",
    formTitle: "Send a message",
    formText: "Fields marked with an asterisk are required.",
  },
  es: {
    title: "Contacto",
    eyebrow: "Contacto",
    heading: "Conversa con la Cámara",
    lead: "Envía un mensaje sobre membresía, eventos, patrocinio, prensa o una consulta general. Nuestro equipo lo dirigirá a la persona adecuada.",
    detailsTitle: "Datos de contacto",
    email: "Correo",
    phone: "Teléfono",
    address: "Dirección",
    social: "Redes",
    privacy: "Para solicitudes de privacidad, escríbenos con el asunto “Solicitud de privacidad”.",
    formTitle: "Enviar un mensaje",
    formText: "Los campos con asterisco son obligatorios.",
  },
} as const;

const text = copy[lang];
const social = [
  { label: "LinkedIn", href: SITE.social.linkedin },
  { label: "Facebook", href: SITE.social.facebook },
  { label: "Instagram", href: SITE.social.instagram },
  { label: "YouTube", href: SITE.social.youtube },
];
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.lead}
  pathname={`/${lang}/contact/`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1>{text.heading}</h1>
      <p class="lead">{text.lead}</p>

      <div class="contact-layout">
        <aside class="contact-details card">
          <h2>{text.detailsTitle}</h2>
          <dl>
            <dt>{text.email}</dt>
            <dd><a href={SITE.contact.emailHref}>{SITE.contact.email}</a></dd>
            <dt>{text.phone}</dt>
            <dd><a href={SITE.contact.phoneHref}>{SITE.contact.phone}</a></dd>
            <dt>{text.address}</dt>
            <dd>
              {SITE.contact.address}
              <br />
              {SITE.contact.addressSecondary}
            </dd>
            <dt>{text.social}</dt>
            <dd>
              <ul class="contact-social">
                {
                  social.map((item) => (
                    <li>
                      <a href={item.href} rel="noopener noreferrer">
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </dl>
          <p class="contact-details__note">{text.privacy}</p>
        </aside>

        <div class="contact-form-wrap">
          <h2>{text.formTitle}</h2>
          <p class="contact-form-wrap__hint">{text.formText}</p>
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  .contact-details {
    padding: 1.75rem;
  }

  .contact-details h2,
  .contact-form-wrap h2 {
    font-size: var(--text-xl);
  }

  .contact-details dl {
    margin: 0;
  }

  .contact-details dt {
    margin-top: 1rem;
    color: var(--color-gold-600);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-details dt:first-child {
    margin-top: 0;
  }

  .contact-details dd {
    margin: 0.2rem 0 0;
    color: var(--color-body);
    font-size: var(--text-sm);
  }

  .contact-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-details__note {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .contact-form-wrap {
    padding: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }

  .contact-form-wrap__hint {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(260px, 0.55fr) minmax(0, 1.45fr);
    }
  }
</style>
