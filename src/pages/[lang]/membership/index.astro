---
import BaseLayout from "@layouts/BaseLayout.astro";
import { MEMBERSHIP_PLANS, formatBenefitValue } from "@data/memberships";
import { isLang, type Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const params = Astro.params;
const lang: Lang = isLang(params.lang) ? params.lang : "en";

const copy = {
  en: {
    title: "Membership",
    eyebrow: "Membership",
    heading: "A membership built around your business",
    lead: "Join a network of businesses working together to grow and compete. Compare levels, review benefits, and apply when you are ready.",
    plans: "Compare membership levels",
    benefits: "See all benefits",
    apply: "Apply for membership",
    asideTitle: "Annual membership",
    asideText:
      "Membership dues are billed annually in US dollars. Sponsorships, event tickets, and paid services are separate from membership dues.",
  },
  es: {
    title: "Membresía",
    eyebrow: "Membresía",
    heading: "Una membresía construida alrededor de tu empresa",
    lead: "Únete a una red de empresas que trabajan juntas para crecer y competir. Compara niveles, revisa beneficios y solicita tu ingreso cuando estés listo.",
    plans: "Comparar niveles",
    benefits: "Ver todos los beneficios",
    apply: "Solicitar membresía",
    asideTitle: "Membresía anual",
    asideText:
      "Las cuotas de membresía se facturan anualmente en dólares estadounidenses. Los patrocinios, entradas a eventos y servicios pagados son independientes de la cuota de membresía.",
  },
} as const;

const text = copy[lang];
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.lead}
  pathname={`/${lang}/membership/`}
>
  <section class="section">
    <div class="container membership-hero">
      <div>
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.heading}</h1>
        <p class="lead">{text.lead}</p>
        <div class="membership-hero__actions">
          <a class="btn btn--primary" href={localizedHref("plans", lang)}>
            {text.plans}
          </a>
          <a class="btn btn--ghost" href={localizedHref("benefits", lang)}>
            {text.benefits}
          </a>
        </div>
      </div>
      <aside class="membership-aside card">
        <h2>{text.asideTitle}</h2>
        <p>{text.asideText}</p>
        <a class="btn btn--gold" href={localizedHref("apply", lang)}>
          {text.apply}
        </a>
      </aside>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <ul class="plan-summary">
        {
          MEMBERSHIP_PLANS.map((plan) => (
            <li class="plan-summary__item" data-reveal="up">
              <h3>{plan.name}</h3>
              <p class="plan-summary__price">
                <span>
                  {new Intl.NumberFormat(lang === "es" ? "es-US" : "en-US", {
                    style: "currency",
                    currency: plan.currency,
                    maximumFractionDigits: 0,
                  }).format(plan.price)}
                </span>
                <small>{lang === "es" ? "por año" : "per year"}</small>
              </p>
              <p class="plan-summary__audience">{plan.audience[lang]}</p>
              <p class="plan-summary__guests">
                {
                  formatBenefitValue(
                    plan.benefits.find(
                      (benefit) => benefit.key === "event_guests_allowed",
                    )?.value ?? 0,
                    lang,
                  )
                }
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .membership-hero {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .membership-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .membership-aside {
    padding: 2rem;
    border-top: 4px solid var(--color-gold-500);
  }

  .membership-aside h2 {
    font-size: var(--text-xl);
  }

  .membership-aside p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .plan-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-summary__item {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }

  .plan-summary__item h3 {
    margin-bottom: 0.4rem;
    font-size: var(--text-xl);
  }

  .plan-summary__price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0 0 0.75rem;
    color: var(--color-navy-800);
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1;
  }

  .plan-summary__price small {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .plan-summary__audience {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .plan-summary__guests {
    margin: 0;
    color: var(--color-navy-700);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .membership-hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
    }
  }
</style>
