---
import BaseLayout from "@layouts/BaseLayout.astro";
import MembershipForm from "@components/forms/MembershipForm.astro";
import { SITE } from "@data/site";
import { isLang, type Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const params = Astro.params;
const lang: Lang = isLang(params.lang) ? params.lang : "en";

const copy = {
  en: {
    title: "Apply for membership",
    eyebrow: "Application",
    heading: "Start your membership application",
    lead: "Tell us about your company and the level you are interested in. Our team will follow up with next steps.",
    prepareTitle: "What to have ready",
    prepare: [
      "Company legal or commercial name",
      "Contact name, email, and phone",
      "Preferred membership level",
      "A short description of your business",
    ],
    plans: "Review membership levels",
    fallbackLabel: "Prefer email?",
    fallback: "Contact the membership team directly.",
    asideTitle: "How this works",
    aside: [
      "We review your request and confirm the appropriate level.",
      "We contact you to complete the application and payment details.",
      "Your membership begins once the application is approved and paid.",
    ],
  },
  es: {
    title: "Solicitar membresía",
    eyebrow: "Solicitud",
    heading: "Comienza tu solicitud de membresía",
    lead: "Cuéntanos sobre tu empresa y el nivel que te interesa. Nuestro equipo te contactará con los siguientes pasos.",
    prepareTitle: "Ten a mano",
    prepare: [
      "Nombre legal o comercial de la empresa",
      "Nombre, correo y teléfono de contacto",
      "Nivel de membresía preferido",
      "Una breve descripción de tu negocio",
    ],
    plans: "Revisar niveles de membresía",
    fallbackLabel: "¿Prefieres escribir?",
    fallback: "Contacta directamente al equipo de membresía.",
    asideTitle: "Cómo funciona",
    aside: [
      "Revisamos tu solicitud y confirmamos el nivel adecuado.",
      "Te contactamos para completar la solicitud y los datos de pago.",
      "La membresía comienza cuando la solicitud es aprobada y pagada.",
    ],
  },
} as const;

const text = copy[lang];
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.lead}
  pathname={`/${lang}/membership/apply/`}
>
  <section class="section">
    <div class="container apply-layout">
      <div>
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.heading}</h1>
        <p class="lead">{text.lead}</p>

        <MembershipForm lang={lang} />

        <p class="apply-fallback">
          {text.fallbackLabel}
          <a href={SITE.contact.emailHref}>{text.fallback}</a>
        </p>
      </div>

      <aside class="apply-aside">
        <div class="card apply-aside__card">
          <h2>{text.asideTitle}</h2>
          <ol>
            {
              text.aside.map((step) => (
                <li>{step}</li>
              ))
            }
          </ol>
          <a class="btn btn--ghost" href={localizedHref("plans", lang)}>
            {text.plans}
          </a>
        </div>
        <div class="card apply-aside__card">
          <h2>{text.prepareTitle}</h2>
          <ul>
            {
              text.prepare.map((item) => (
                <li>{item}</li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .apply-layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .apply-aside {
    display: grid;
    gap: 1.25rem;
  }

  .apply-aside__card {
    padding: 1.5rem;
  }

  .apply-aside__card h2 {
    font-size: var(--text-xl);
  }

  .apply-aside__card ul,
  .apply-aside__card ol {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .apply-fallback {
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .apply-layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.5fr);
    }
  }
</style>
