---
import BaseLayout from "@layouts/BaseLayout.astro";
import Slider from "@components/sections/Slider.astro";
import { getSlides } from "@data/slider";
import { isLang, type Lang } from "@lib/lang";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const params = Astro.params;
const lang: Lang = isLang(params.lang) ? params.lang : "en";

const copy = {
  en: {
    title: "American Chamber of Commerce",
    description:
      "A member-driven chamber connecting businesses with the network, knowledge, and advocacy they need to grow.",
  },
  es: {
    title: "American Chamber of Commerce",
    description:
      "Una cámara impulsada por sus miembros que conecta empresas con la red, el conocimiento y la defensa que necesitan para crecer.",
  },
} as const;

const content = copy[lang];
---

<BaseLayout lang={lang} title={content.title} description={content.description}>
  <Slider slides={getSlides(lang)} lang={lang} />
</BaseLayout>
