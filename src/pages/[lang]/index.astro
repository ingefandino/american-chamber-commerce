---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Slider from "@components/sections/Slider.astro";
import TrustBar from "@components/sections/TrustBar.astro";
import Benefits from "@components/sections/Benefits.astro";
import CtaBand from "@components/sections/CtaBand.astro";
import SectionHeading from "@components/sections/SectionHeading.astro";
import { getSlides } from "@data/slider";
import { HOME_CONTENT } from "@data/home";
import { SITE } from "@data/site";
import { isLang, type Lang } from "@lib/lang";
import { localizedHref } from "@lib/routes";
import newYork from "@assets/webp/about/new-york.webp";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const params = Astro.params;
const lang: Lang = isLang(params.lang) ? params.lang : "en";
const content = HOME_CONTENT[lang];
const pathname = `/${lang}/`;
---

<BaseLayout
  lang={lang}
  title={SITE.name}
  description={SITE.description[lang]}
  pathname={pathname}
>
  <Slider slides={getSlides(lang)} lang={lang} />

  <TrustBar label={content.trustLabel} items={content.trustItems} />

  <section class="section">
    <div class="container intro">
      <div class="intro__media" data-reveal="left">
        <Image
          src={newYork}
          alt={
            lang === "es"
              ? "Vista de una calle de Manhattan, Nueva York"
              : "Street view of Midtown Manhattan, New York City"
          }
          widths={[360, 480, 640]}
          sizes="(max-width: 900px) 100vw, 42vw"
          loading="lazy"
        />
      </div>
      <div class="intro__copy" data-reveal="right">
        <SectionHeading
          eyebrow={content.introEyebrow}
          title={content.introTitle}
          lead={content.introText}
        />
        <ul class="intro__values">
          {
            SITE.values[lang].map((value) => (
              <li>{value}</li>
            ))
          }
        </ul>
        <a class="btn btn--ghost" href={localizedHref("about", lang)}>
          {lang === "es" ? "Conoce la Cámara" : "About the Chamber"}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        eyebrow={content.pillarsEyebrow}
        title={content.pillarsTitle}
      />
      <ul class="pillars">
        {
          content.pillars.map((pillar, index) => (
            <li
              class="pillar"
              data-reveal="up"
              style={`--reveal-delay:${index * 90}ms`}
            >
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
              <a class="pillar__link" href={localizedHref(pillar.cta.key, lang)}>
                {pillar.cta.label}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Benefits
    eyebrow={content.benefitsEyebrow}
    title={content.benefitsTitle}
    lead={content.benefitsLead}
    items={content.benefits.map((benefit) => ({
      title: benefit.title,
      text: benefit.text,
      href: localizedHref(benefit.cta.key, lang),
      ctaLabel: benefit.cta.label,
    }))}
  />

  <CtaBand
    title={content.cta.title}
    text={content.cta.text}
    primary={{
      label: content.cta.primary.label,
      href: localizedHref(content.cta.primary.key, lang),
    }}
    secondary={{
      label: content.cta.secondary.label,
      href: localizedHref(content.cta.secondary.key, lang),
    }}
  />
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .intro__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 5;
  }

  .intro__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(180deg, transparent, rgb(7 26 48 / 0.35));
    pointer-events: none;
  }

  .intro__values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 0.5rem 1.5rem;
    margin: 1.5rem 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  .intro__values li {
    position: relative;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-body);
    font-size: var(--text-sm);
  }

  .intro__values li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold-500);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar {
    position: relative;
    margin: 0;
    padding: 2rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }

  .pillar::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--color-gold-500);
  }

  .pillar h3 {
    margin-bottom: 0.5rem;
    font-size: var(--text-xl);
  }

  .pillar p {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .pillar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-navy-700);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .pillar__link:hover,
  .pillar__link:focus-visible {
    color: var(--color-gold-600);
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
