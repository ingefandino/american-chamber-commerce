---
import { DEFAULT_LANG } from "@lib/lang";
import { localizedHref } from "@lib/routes";

const target = localizedHref("home", DEFAULT_LANG);
---

<!doctype html>
<html lang={DEFAULT_LANG} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>American Chamber of Commerce</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`1; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>Continue to the American Chamber of Commerce</a></p>
    <script>
      import { DEFAULT_LANG, LANG_COOKIE, normalizeLang } from "@lib/lang";

      const preference = document.cookie
        .split(";")
        .map((part) => part.trim())
        .find((part) => part.startsWith(`${LANG_COOKIE}=`))
        ?.split("=")
        .slice(1)
        .join("=");

      const lang = normalizeLang(preference, DEFAULT_LANG);
      const destination = lang === DEFAULT_LANG ? `/${DEFAULT_LANG}/` : `/${lang}/`;
      if (location.pathname !== destination) {
        location.replace(destination);
      }
    </script>
  </body>
</html>
